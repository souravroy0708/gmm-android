<resources>
    <style name="Theme.GMM" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#0F2F1E</item>
        <item name="android:navigationBarColor">#F5F7F2</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <style name="Theme.GMM.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F2F1E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.GMM</item>
    </style>
</resources>
